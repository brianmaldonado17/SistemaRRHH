@model IEnumerable<SistemaRRHH.Models.Prestacion>

@{
    ViewData["Title"] = "Historial de Prestaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gift-fill me-2"></i> Historial de Prestaciones</h2>
        <a asp-action="Calcular" class="btn btn-success shadow-sm">
            <i class="bi bi-calculator"></i> Nuevo Cálculo
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Aviso:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Colaborador</th>
                            <th>Tipo de Prestación</th>
                            <th>Período Cubierto</th>
                            <th class="text-end">Monto a Pagar</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.Estado == "Anulada" ? "text-muted bg-light" : "")">
                                    <td class="align-middle @(item.Estado == "Anulada" ? "text-decoration-line-through" : "")">
                                        @item.FechaCalculo.ToShortDateString()
                                    </td>
                                    <td class="align-middle fw-bold @(item.Estado == "Anulada" ? "text-decoration-line-through" : "")">
                                        @item.NombreEmpleado
                                    </td>
                                    <td class="align-middle @(item.Estado == "Anulada" ? "text-decoration-line-through" : "")">
                                        <span class="badge bg-info text-dark">@item.TipoPrestacion</span>
                                    </td>
                                    <td class="align-middle @(item.Estado == "Anulada" ? "text-decoration-line-through" : "")">
                                        @item.PeriodoCubierto
                                    </td>
                                    <td class="align-middle text-end fw-bold @(item.Estado == "Anulada" ? "text-muted" : "text-success")">
                                        Q @item.MontoPagado.ToString("N2")
                                    </td>
                                    <td class="text-center align-middle">
                                        @if (item.Estado == "Pagada")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-all me-1"></i>Pagada</span>
                                        }
                                        else if (item.Estado == "Anulada")
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i>Anulada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>Pendiente</span>
                                        }
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            @if (item.Estado != "Pagada" && item.Estado != "Anulada")
                                            {
                                                <form asp-action="Pagar" asp-route-id="@item.IdPrestacion" method="post" onsubmit="return confirm('¿Confirmar el pago de esta prestación? Una vez pagada no podrá ser anulada.');">
                                                    <button type="submit" class="btn btn-sm btn-success" title="Marcar como Pagada">
                                                        <i class="bi bi-cash-coin me-1"></i> Pagar
                                                    </button>
                                                </form>

                                                <form asp-action="Anular" asp-route-id="@item.IdPrestacion" method="post" onsubmit="return confirm('¿Está seguro de anular este cálculo de prestación?');">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Anular Cálculo">
                                                        <i class="bi bi-trash me-1"></i> Anular
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><i class="bi bi-dash"></i></span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No se han registrado cálculos de prestaciones todavía.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>