@model IEnumerable<SistemaRRHH.Models.Rol>

@{
    ViewData["Title"] = "Roles del Sistema";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-shield-lock"></i> Roles del Sistema</h2>
        <a asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Rol
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="10%" class="text-center">ID</th>
                        <th>Descripción del Rol</th>
                        <th width="15%" class="text-center">Estado</th>
                        <th width="25%" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Estado == "Inactivo" ? "text-muted bg-light" : "")">
                                <td class="text-center align-middle fw-bold">@item.IdRol</td>
                                <td class="align-middle @(item.Estado == "Inactivo" ? "text-decoration-line-through" : "")">
                                    @item.NombreRol
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.Estado == "Activo")
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (item.Estado == "Activo")
                                        {
                                            <a asp-action="Editar" asp-route-id="@item.IdRol" class="btn btn-sm btn-primary">
                                                <i class="bi bi-pencil-square me-1"></i> Editar
                                            </a>
                                            <form asp-action="Anular" asp-route-id="@item.IdRol" method="post" onsubmit="return confirm('¿Seguro que desea inactivar este rol?');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-circle me-1"></i> Anular
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activar" asp-route-id="@item.IdRol" method="post" onsubmit="return confirm('¿Desea reactivar este rol?');">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-circle me-1"></i> Activar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                No hay roles registrados todavía.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>