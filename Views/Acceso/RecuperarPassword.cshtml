@{
    Layout = null;
    ViewData["Title"] = "Recuperar Contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema RRHH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center" style="min-height: 100vh;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <div class="card shadow-lg border-0 rounded-lg mt-5">
                    <div class="card-header bg-dark text-white text-center py-4">
                        <h3 class="font-weight-light my-2">Recuperar Acceso</h3>
                    </div>

                    <div class="card-body p-4">
                        <p class="text-muted text-center small mb-4">Ingresa el correo electrónico asociado a tu usuario y te enviaremos una clave temporal.</p>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger text-center py-2" role="alert">
                                @ViewBag.Error
                            </div>
                        }
                        @if (ViewBag.Mensaje != null)
                        {
                            <div class="alert alert-success text-center py-2" role="alert">
                                @ViewBag.Mensaje
                            </div>
                        }

                        <form asp-controller="Acceso" asp-action="RecuperarPassword" method="post">
                            <div class="form-floating mb-4">
                                <input name="correoDestino" class="form-control" id="inputCorreo" type="email" placeholder="correo@ejemplo.com" required />
                                <label for="inputCorreo">Correo Electrónico</label>
                            </div>

                            <div class="d-grid gap-2 mt-4 mb-0">
                                <button class="btn btn-warning btn-lg" type="submit">Enviar Correo</button>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center py-3 bg-white">
                        <div class="small">
                            <a asp-controller="Acceso" asp-action="Login" class="text-decoration-none">Regresar a Iniciar Sesión</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>