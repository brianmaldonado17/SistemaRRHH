<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-briefcase"></i> Editar Puesto de Trabajo</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Editar" method="post">
                        <input type="hidden" name="IdPuesto" value="@Model.IdPuesto" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Puesto</label>
                            <input type="text" name="NombrePuesto" class="form-control" value="@Model.NombrePuesto" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Salario Base (Mensual)</label>
                            <div class="input-group">
                                <span class="input-group-text">Q</span>
                                <input type="number" name="SalarioBase" class="form-control" value="@Model.SalarioBase" step="0.01" required />
                            </div>
                            <small class="text-muted">Este monto se usará para el cálculo automático de nóminas y prestaciones.</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-secondary">Regresar al Listado</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>