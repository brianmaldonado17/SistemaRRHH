@model SistemaRRHH.Models.Puesto

@{
    ViewData["Title"] = "Crear Puesto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Registrar Puesto</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Crear" method="post">
                        <div class="mb-3">
                            <label asp-for="NombrePuesto" class="form-label">Nombre del Puesto</label>
                            <input asp-for="NombrePuesto" class="form-control" placeholder="Ej. Analista Programador, Contador, Jefe, Subjefe" autocomplete="off" />
                            <span asp-validation-for="NombrePuesto" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SalarioBase" class="form-label">Salario base del Puesto</label>
                            <input asp-for="SalarioBase" type="number" step="0.01" class="form-control" placeholder="Ej. 3000.50" autocomplete="off" />
                            <span asp-validation-for="SalarioBase" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Guardar</button>
                            <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}