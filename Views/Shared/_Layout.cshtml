<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaRRHH</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaRRHH.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SistemaRRHH</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (User.IsInRole("Administrador") || User.IsInRole("RecursosHumanos"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="navCatalogos" role="button" data-bs-toggle="dropdown">Catálogos Base</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Departamentos" asp-action="Index">Departamentos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Puestos" asp-action="Index">Puestos</a></li>                                    
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Gestión de Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Roles</a></li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Empleados" asp-action="Index">Colaboradores</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Nominas" asp-action="Index">Nóminas</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Prestaciones" asp-action="Index">Prestaciones</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Ausencias" asp-action="Index">Ausencias</a></li>
                        }

                        @if (User.IsInRole("Colaborador"))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="MiPerfil" asp-action="MisPagos">Mis Boletas de Pago</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li>
                                    <a class="dropdown-item" asp-controller="MiPerfil" asp-action="CambiarPassword">
                                        <i class="bi bi-key me-2"></i> Cambiar Contraseña
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Acceso" asp-action="Salir">
                                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Sistema de Recursos Humanos - Proyecto de Ingeniería de Software
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
