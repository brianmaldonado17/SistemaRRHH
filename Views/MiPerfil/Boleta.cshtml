@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Boleta de Pago</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .boleta-container {
            max-width: 800px;
            margin: 40px auto;
            background: #fff;
            padding: 40px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .logo-placeholder {
            width: 150px;
            height: 50px;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #6c757d;
        }

        /* CORRECCIÓN RAZOR: Usamos @@ para escapar el arroba en CSS */
        @@media print {
            .no-print {
                display: none !important;
            }

            .boleta-container {
                box-shadow: none;
                margin: 0;
                padding: 0;
                border: none !important; /* Quitamos bordes al imprimir */
            }

            body {
                background-color: #fff;
            }
        }
    </style>
</head>
<body>
    <div class="boleta-container border">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="fw-bold mb-0">SISTEMA DE RECURSOS HUMANOS</h3>
                <p class="text-muted mb-0 small">NIT: 1234567-8 | Guatemala, C.A.</p>
            </div>
            <div class="text-end">
                <h4 class="text-primary fw-bold mb-0">BOLETA DE PAGO</h4>
                <p class="mb-0 text-muted">Fecha: @ViewBag.Pago.Fecha.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <div class="bg-light p-3 rounded mb-4">
            <div class="row">
                <div class="col-sm-6">
                    <p class="mb-1"><strong>Colaborador:</strong> @ViewBag.Empleado.NombreCompleto</p>
                </div>
                <div class="col-sm-6">
                    <p class="mb-1"><strong>Puesto:</strong> @ViewBag.Empleado.Puesto</p>
                </div>
            </div>
        </div>

        <h6 class="fw-bold mb-3">Detalle de Ingresos y Descuentos</h6>
        <table class="table table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th>Concepto</th>
                    <th class="text-end">Ingresos</th>
                    <th class="text-end">Deducciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@ViewBag.Pago.Concepto</td>
                    <td class="text-end text-success">
                        Q @((ViewBag.Pago.Total - ViewBag.Pago.Bonos + ViewBag.Pago.IGSS + ViewBag.Pago.ISR).ToString("N2"))
                    </td>
                    <td class="text-end"></td>
                </tr>
                @if (ViewBag.Pago.Bonos > 0)
                {
                    <tr>
                        <td>Bonificación Incentivo</td>
                        <td class="text-end text-success">Q @ViewBag.Pago.Bonos.ToString("N2")</td>
                        <td class="text-end"></td>
                    </tr>
                }
                @if (ViewBag.Pago.IGSS > 0)
                {
                    <tr>
                        <td>Descuento IGSS</td>
                        <td class="text-end"></td>
                        <td class="text-end text-danger">- Q @ViewBag.Pago.IGSS.ToString("N2")</td>
                    </tr>
                }
                @if (ViewBag.Pago.ISR > 0)
                {
                    <tr>
                        <td>Descuento ISR / Otros</td>
                        <td class="text-end"></td>
                        <td class="text-end text-danger">- Q @ViewBag.Pago.ISR.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold">
                    <td class="text-end">TOTAL LÍQUIDO A RECIBIR:</td>
                    <td colspan="2" class="text-center fs-5 text-primary">Q @ViewBag.Pago.Total.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <div class="row text-center mt-5 pt-5">
            <div class="col-6">
                <hr class="w-75 mx-auto border-dark">
                <p class="small fw-bold">Firma de Recibido Conforme</p>
            </div>
            <div class="col-6">
                <hr class="w-75 mx-auto border-dark">
                <p class="small fw-bold">Autorizado por Recursos Humanos</p>
            </div>
        </div>

        <div class="text-center mt-4 no-print">
            <button class="btn btn-primary" onclick="window.print()">
                Imprimir / Guardar como PDF
            </button>
            <button class="btn btn-secondary" onclick="window.close()">Cerrar</button>
        </div>
    </div>
</body>
</html>