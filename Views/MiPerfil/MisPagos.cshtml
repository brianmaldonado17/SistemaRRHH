@model IEnumerable<SistemaRRHH.Models.Prestacion>

@{
    ViewData["Title"] = "Mis Pagos y Boletas";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="display-6"><i class="bi bi-wallet2 text-primary"></i> Mi Historial de Pagos</h2>
            <p class="text-muted">Aquí puedes consultar el detalle de tus nóminas mensuales y prestaciones recibidas.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title text-uppercase small">Último Pago Recibido</h6>
                    <h3 class="mb-0">Q @(Model.FirstOrDefault()?.MontoPagado.ToString("N2") ?? "0.00")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Desglose de Ingresos</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha de Depósito</th>
                            <th>Concepto / Tipo</th>
                            <th>Período Correspondiente</th>
                            <th class="text-end">Monto Líquido</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var pago in Model)
                            {
                                <tr>
                                    <td class="align-middle">@pago.FechaCalculo.ToShortDateString()</td>
                                    <td class="align-middle">
                                        <span class="fw-bold">@pago.TipoPrestacion</span>
                                    </td>
                                    <td class="align-middle">@pago.PeriodoCubierto</td>
                                    <td class="align-middle text-end fw-bold text-success">
                                        Q @pago.MontoPagado.ToString("N2")
                                    </td>
                                    <td class="align-middle text-center">
                                        <a asp-action="Boleta" asp-route-id="@pago.IdTransaccion" asp-route-origen="@pago.Origen" target="_blank" class="btn btn-sm btn-outline-danger" title="Descargar Boleta PDF">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle fs-2"></i><br>
                                    Aún no tienes pagos registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>