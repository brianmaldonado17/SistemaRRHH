@model IEnumerable<SistemaRRHH.Models.Ausencia>

@{
    ViewData["Title"] = "Gestión de Ausencias";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-x"></i> Control de Ausencias e Incidencias</h2>
        <a asp-action="Registrar" class="btn btn-danger shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Registrar Falta
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Fecha</th>
                        <th>Colaborador</th>
                        <th>Motivo</th>
                        <th class="text-center">Descuenta</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Estado == "Inactivo" ? "text-muted bg-light" : "")">
                                <td class="text-center align-middle fw-bold @(item.Estado == "Inactivo" ? "text-decoration-line-through" : "")">
                                    @item.FechaAusencia.ToShortDateString()
                                </td>
                                <td class="align-middle @(item.Estado == "Inactivo" ? "text-decoration-line-through" : "")">
                                    @item.NombreEmpleado
                                </td>
                                <td class="align-middle @(item.Estado == "Inactivo" ? "text-decoration-line-through" : "")">
                                    @item.Motivo
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.DescuentaSalario)
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">No</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.Estado == "Activo")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Anulada</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (item.YaProcesada)
                                        {
                                            <button class="btn btn-sm btn-secondary disabled" title="Bloqueado: Procesado en Nómina" style="opacity: 0.7;">
                                                <i class="bi bi-lock-fill me-1"></i> Nómina Cerrada
                                            </button>
                                        }
                                        else
                                        {
                                            @if (item.Estado == "Activo")
                                            {
                                                <a asp-action="Editar" asp-route-id="@item.IdAusencia" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                                </a>
                                                <form asp-action="Anular" asp-route-id="@item.IdAusencia" method="post" onsubmit="return confirm('¿Está seguro de anular este registro? Dejará de afectar el cálculo de la nómina.');">
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-x-circle me-1"></i> Anular
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activar" asp-route-id="@item.IdAusencia" method="post" onsubmit="return confirm('¿Desea reactivar esta falta? Volverá a aplicar descuentos en la nómina.');">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-arrow-clockwise me-1"></i> Reactivar
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                No hay ausencias registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>